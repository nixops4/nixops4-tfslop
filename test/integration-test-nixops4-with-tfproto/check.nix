# Basic end-to-end proof: `nixops4 apply` works against a resource
# type generated by `nixops4-tfproto.lib.tfProviderToModule` from the
# fixture provider's schema.
#
# The infrastructure here — flake stub, binaries injection, schema
# snapshot, sandboxed nested nix — is deliberately independent of any
# specific feature under test. Later commits extend the deployment
# with more scenarios (sensitive round-trip, etc.); the assertions
# stack up alongside the initial fx_computed round-trip.
#
# Run with:
#   nix build .#checks.<system>.itest-nixops4-with-tfproto
{
  runCommand,
  jq,
  nixops4,
  inputs,
  stdenv,
  nix,
  formats,
  # nixops4's own bottled flake — carries nixops4-resources-local etc.
  # We reuse it wholesale as our `@nixops4@` input so we don't have to
  # duplicate the bottling machinery.
  flake-in-a-bottle,
  die,
  # Our own binaries, injected via `binaries.json` in the sandbox.
  adapter,
  fixture,
  # Path to `nix/lib/lib.nix` in the tfproto source tree.
  nixops4-tfproto-lib,
  # Pre-materialised fixture provider schema JSON. Materialising it
  # inside the sandbox would trigger a runCommand-with-bash IFD
  # against inputs the sandbox can't fetch.
  fixture-schema,
}:

runCommand "itest-nixops4-with-tfproto"
  {
    nativeBuildInputs = [
      nixops4
      jq
      nix
      die
    ];
  }
  ''
    hr() { echo -----------------------------------------------------------------------; }
    h1() { echo; hr; echo "$@"; hr; }
    h2() { echo; echo "$@"; hr; }

    h1 SETTING UP
    mkdir -p $out/logs

    export HOME=$(mktemp -d $TMPDIR/home.XXXXXX)
    # A fresh relocated nix store so the sandboxed eval doesn't touch
    # the real store; mirrors nixops4's itest exactly.
    store_data=$(mktemp -d $TMPDIR/store-data.XXXXXX)
    export NIX_REMOTE="$store_data"
    export NIX_BUILD_HOOK=
    export NIX_CONF_DIR=$store_data/etc
    export NIX_LOCALSTATE_DIR=$store_data/nix/var
    export NIX_LOG_DIR=$store_data/nix/var/log/nix
    export NIX_STATE_DIR=$store_data/nix/var/nix

    mkdir -p $NIX_CONF_DIR
    echo 'extra-experimental-features = flakes nix-command' > $store_data/etc/nix.conf
    echo 'substituters =' >> $store_data/etc/nix.conf

    cp -r --no-preserve=mode ${./flake}/ work
    cd work
    substituteInPlace flake.nix \
      --replace-fail '@nixpkgs@' ${inputs.nixpkgs} \
      --replace-fail '@nixops4@' ${flake-in-a-bottle} \
      --replace-fail '@nixops4-tfproto-lib@' ${nixops4-tfproto-lib} \
      --replace-fail '@fixture-schema@' ${fixture-schema} \
      --replace-fail '@flake-parts@' ${inputs.flake-parts} \
      --replace-fail '@system@' ${stdenv.hostPlatform.system} \
      --replace-fail '@binaries@' ${
        (formats.json { }).generate "binaries.json" {
          inherit adapter fixture;
        }
      } \
      ;

    (
      set -x

      nix flake lock -vv
      # `path:` inputs get a lastModified=1 tag that nix then rejects
      # as a mismatch. Same workaround nixops4's flake-in-a-bottle
      # applies to itself.
      sed -i -e 's|"lastModified": 1,||g' flake.lock

      nix eval .#nixops4._type --show-trace

      h1 BASIC ROUND-TRIP
      nixops4 apply -v basicDeployment --show-trace

      test -f basic-state.json

      # The `witness` memo persisted `echo.outputs.id`, which the
      # provider populated as "computed-<value>". Scan the state's
      # JSON-patch log for that string in an `initialize_with`
      # position — proves the round-trip nix → adapter → fixture →
      # back to nix all worked.
      jq -es '
        [.[] | .patch[]?
               | .. | objects
               | select(.initialize_with? == "computed-hello")]
          | length > 0
      ' basic-state.json | grep -q true || {
        echo "FAIL: no evidence the fx_computed round-trip settled"
        cat basic-state.json
        exit 1
      }

      rm -f basic-state.json
    )

    h1 PROVIDER CONFIGURATION
    (
      set -x
      nixops4 apply -v providerDeployment --show-trace

      test -f provider-state.json

      # `inputs.provider.tag` must reach ConfigureProvider and come
      # back as fx_provider_echo's computed `value`, which the witness
      # memo persisted. The fixture has no `provider` attribute on the
      # resource, so had the adapter left it in the config, Plan would
      # have failed instead.
      jq -es '
        [.[] | .patch[]?
               | .value? | .. | objects
               | select(.initialize_with? == "configured-from-nix")]
          | length > 0
      ' provider-state.json | grep -q true || {
        echo "FAIL: inputs.provider did not reach ConfigureProvider"
        cat provider-state.json
        exit 1
      }

      rm -f provider-state.json
    )
    h1 REPLACEMENT
    (
      set -x
      echo "=== A ForceNew attribute drives a replacement through nixops4 ==="

      nixops4 apply -v replaceDeployment --show-trace
      test -f replace-state.json

      # How many events the log holds, so the assertions below read
      # only what the second apply appended.
      before=$(jq -s 'length' replace-state.json)

      # `value` is ForceNew in the fixture's schema, so the provider
      # answers the plan with requires_replace and the adapter reports
      # it rather than applying. nixops4 destroys the resource and
      # creates it again.
      sed -i 's/replaceValue = "before";/replaceValue = "after";/' flake.nix
      nixops4 apply -v replaceDeployment --show-trace 2> replace.stderr

      grep -F 'The following resources were replaced:' replace.stderr
      grep -F '  - resource replaceDeployment.thing' replace.stderr

      # The destroy of the old resource, the create of the new one, and
      # then the dependent recording what it read.
      events=$(jq -sc "[.[$before:][] | .meta.event // empty]" replace-state.json)
      [[ '["destroy","create","update"]' == "$events" ]] || {
        echo "FAIL: unexpected state events for the replacement: $events"
        cat replace-state.json
        exit 1
      }

      # The new resource's output is what reached the dependent: the
      # provider derives `id` from `value`, which is what changed.
      jq -es '
        [.[] | .patch[]?
               | select((.path | endswith("/witness/input_properties/initialize_with"))
                        and .value == "id-for-after")]
          | length > 0
      ' replace-state.json | grep -q true || {
        echo "FAIL: the dependent did not get the new resource's output"
        cat replace-state.json
        exit 1
      }

      mv replace.stderr $out/logs/replace.stderr
      rm -f replace-state.json
    )

    h1 SENSITIVE ROUND-TRIP
    (
      set -x
      echo "=== Testing sensitive-value round-trip through a tfproto-generated provider ==="

      # The deployment declares
      #   secret = mkSensitive {...} "hunter2"
      # and points `computed_secret` (sensitive-declared output) at
      # a downstream memo whose input demands a sensitive marker.
      # Three things must all hold after apply:
      #
      # (1) The provider process saw a PLAIN value — proved by
      #     inspecting the file the fixture writes. This is the
      #     nixops4-resource framework's `strip_request_markers`
      #     doing its job on the provider side of the pipe.
      # (2) State preserves the marker on both sides: `secret`
      #     (input) AND `computed_secret` (output). The output
      #     side is what the tfproto adapter's
      #     `wrap_sensitive_outputs` provides — no
      #     `improveRawOutputs`; the adapter constructs the marker
      #     around the plain value the provider returned.
      # (3) Downstream Nix observed `.outputs.computed_secret` as
      #     a proper sensitive marker (via the throw-on-else memo
      #     whose successful evaluation persists a corroborating
      #     string).
      # Capture stdout+stderr so the redaction assertions further
      # below can inspect the log for the plaintext (should be
      # absent) and the `<sensitive value from: ...>` shape (should
      # be present). The fixture provider deliberately writes the
      # received secret to its own stderr — that write inherits fd 2
      # (the runner's shovel pipe) and gets redacted before reaching
      # the terminal.
      apply_log=$(mktemp "$TMPDIR/sensitive-apply.XXXXXX.log")
      nixops4 apply -v sensitiveDeployment --show-trace \
        > >(tee -a "$apply_log") 2> >(tee -a "$apply_log" >&2)

      test -f sensitive-echo-observed.txt
      test -f sensitive-state.json

      # (0) End-to-end redaction. `downstream` reveals `echo`'s
      # sensitive output (COMPUTED:hunter2) and re-wraps it as its
      # own input. In verbose mode nixops4 emits a debug print of
      # the resolved inputs via `eprintln!` from work.rs — a real
      # accidental-leak vector for any operator running with `-v`.
      # By the time `downstream` runs, `echo`'s Create response has
      # been ingested, so the register knows COMPUTED:hunter2 and
      # the fd-2 shovel redacts the eprintln! line before it hits
      # the terminal.
      # Assertions:
      # - The debug print for `downstream`'s inputs does NOT contain
      #   the plaintext COMPUTED:hunter2 verbatim (redaction fired).
      # - The redaction marker `<sensitive value from: ...>` shows
      #   up in the log — proof the register was consulted.
      # Note: `echo`'s OWN Create is not covered by this assertion —
      # its response is what populates the register, so any prior
      # print of its inputs precedes registration and would leak.
      # Input-side ingestion is a separate later slice.
      if grep -q 'COMPUTED:hunter2' "$apply_log"; then
        echo "FAIL: apply output contains the unredacted derived secret"
        exit 1
      fi
      if ! grep -q '<sensitive value from:' "$apply_log"; then
        echo "FAIL: apply output missing the expected redaction marker"
        exit 1
      fi

      # (1) File contents are plain.
      observed=$(cat sensitive-echo-observed.txt)
      [[ "$observed" == '"hunter2"' ]] || {
        echo "FAIL: provider observed unexpected value: $observed"
        exit 1
      }

      # (2a) Input side: state preserves a marker for `secret`.
      jq -es '
        [.[] | .patch[]?
               | .. | objects
               | select(.secret? and (.secret._type? == "sensitive")
                                  and (.secret.value == "hunter2"))]
          | length > 0
      ' sensitive-state.json | grep -q true || {
        echo "FAIL: no marker-shape sensitive input in state file"
        cat sensitive-state.json
        exit 1
      }

      # (2b) Output side: state preserves a marker for
      # `computed_secret`. Adapter's `wrap_sensitive_outputs`.
      jq -es '
        [.[] | .patch[]?
               | .. | objects
               | select(.computed_secret? and (.computed_secret._type? == "sensitive")
                                           and (.computed_secret.value == "COMPUTED:hunter2"))]
          | length > 0
      ' sensitive-state.json | grep -q true || {
        echo "FAIL: no marker-shape sensitive output in state file"
        cat sensitive-state.json
        exit 1
      }

      # (3) Downstream reconstruction: memo persisted the positive
      # branch of the throw-on-else check.
      jq -es '
        [.[] | .patch[]?
               | .. | objects
               | select(.initialize_with?
                          == "echo.outputs.computed_secret is a proper sensitive marker")]
          | length > 0
      ' sensitive-state.json | grep -q true || {
        echo "FAIL: no evidence of the output-marker assertion firing"
        cat sensitive-state.json
        exit 1
      }

      h2 "=== Rotate the sensitive input, re-apply, expect an Update ==="

      # Rotate the sensitive input by editing the deployment flake in
      # place. The re-apply drives the fx_sensitive Update path — the
      # observation file must reflect the new plain value, and the
      # state's update event must carry both the new input value and
      # the derived computed_secret.
      sed -i -e 's/hunter2/newpass/g' flake.nix
      # Remove the observation file so a passing assertion below
      # can't be satisfied by the stale Create-time file.
      rm -f sensitive-echo-observed.txt
      nixops4 apply -v sensitiveDeployment --show-trace

      test -f sensitive-echo-observed.txt
      observed=$(cat sensitive-echo-observed.txt)
      [[ "$observed" == '"newpass"' ]] || {
        echo "FAIL: rotated input not observed by provider: $observed"
        exit 1
      }

      # Shape-agnostic: any string equal to "newpass" appearing
      # inside an update event's patches proves the rotation
      # reached state. Deep-diff or full-record replacement both
      # satisfy this.
      for expected in newpass COMPUTED:newpass; do
        jq -es --arg v "$expected" '
          [.[] | select((.meta.event // "") == "update")
               | .patch | .. | strings
               | select(. == $v)]
            | length > 0
        ' sensitive-state.json | grep -q true || {
          echo "FAIL: no update event carrying rotated value '$expected'"
          cat sensitive-state.json
          exit 1
        }
      done

      h2 "=== Destroy: no leak, state records the removal ==="

      # We only destroy `echo` (the sensitive resource). The memo
      # `echoOutputAssertion` also lives in state, but the local
      # provider doesn't implement destroy for `memo`; leaving its
      # entry stale in state is harmless because we don't re-apply.
      # Capture stdout+stderr for the leak check.
      destroy_log=$(mktemp "$TMPDIR/destroy.XXXXXX.log")
      nixops4 destroy sensitiveDeployment.echo \
        > >(tee -a "$destroy_log") 2> >(tee -a "$destroy_log" >&2)

      if grep -E 'hunter2|newpass' "$destroy_log"; then
        echo "FAIL: destroy path leaked a sensitive input value"
        exit 1
      fi

      jq -es '
        [.[] | select((.meta.event // "") == "destroy")] | length >= 1
      ' sensitive-state.json | grep -q true || {
        echo "FAIL: expected a destroy event in state"
        cat sensitive-state.json
        exit 1
      }

      rm -f sensitive-echo-observed.txt sensitive-state.json
    )

    h1 SUCCESS
    touch $out
  ''
