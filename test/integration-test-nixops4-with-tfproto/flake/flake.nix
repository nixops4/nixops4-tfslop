# Part of test: ../check.nix
# It can only be used as part of that test.
#
# Basic end-to-end proof: `nixops4 apply` against a resource type
# whose module was generated by `nixops4-tfproto.lib.tfProviderToModule`
# from the fixture provider's schema.
#
# The `sensitiveDeployment` in a later commit builds on this same
# infrastructure — check.nix, binaries injection, schema snapshot —
# so both live in one place.
#
# We deliberately do *not* declare `nixops4-tfproto` as a flake input.
# `nix flake lock` inside the sandbox has no network, and tfproto's
# transitive inputs (nix-cargo-integration, ...) aren't easily
# `follows`-shimmed into placeholder flakes. Instead, the outer
# check injects the tfproto library source as a path substitution
# (`@nixops4-tfproto-lib@`) and we `import` the lib module directly.
# Only the *library* is exercised at eval time here; the adapter and
# fixture *binaries* are pre-built and delivered via `@binaries@`.
{
  inputs = {
    nixpkgs.url = "@nixpkgs@";
    nixops4.url = "@nixops4@";
    flake-parts.url = "@flake-parts@";
    flake-parts.inputs.nixpkgs-lib.follows = "nixpkgs";
  };

  outputs =
    inputs@{ flake-parts, ... }:
    flake-parts.lib.mkFlake { inherit inputs; } (
      { ... }:
      {
        imports = [
          inputs.nixops4.modules.flake.default
        ];
        systems = [ "@system@" ];
        nixops4 =
          {
            lib,
            providers,
            ...
          }:
          let
            # Adapter and fixture binaries are pre-built by the outer
            # check and injected via @binaries@ so the sandboxed nix
            # eval doesn't try to build them itself.
            binaries = lib.importJSON "@binaries@";

            # The provider schema is pre-materialised outside the
            # sandbox: materialiseProviderSchema uses `runCommand`
            # which needs bash, which needs a network the sandbox
            # doesn't have. Skipping the IFD keeps eval offline.
            fixtureSchema = lib.importJSON "@fixture-schema@";

            # Import the tfproto library directly from its source
            # (see the header comment for why not via flake input).
            tfLib = import "@nixops4-tfproto-lib@" {
              inherit lib;
              nixops4Lib = inputs.nixops4.lib;
            };

            # The tfproto-generated provider module. Skips the schema
            # IFD (already materialised above) and calls the schema →
            # module translator directly.
            tfFixtureModule = tfLib.tfCommonSchemaToModule {
              adapterExecutable = "${binaries.adapter}/bin/nixops4-resources-tfproto";
              providerExecutable = "${binaries.fixture}/bin/fixture";
              schema = fixtureSchema;
            };
          in
          {
            providers.local = inputs.nixops4.modules.nixops4Provider.local;
            providers.tfFixture = tfFixtureModule;

            members.basicDeployment =
              { members, ... }:
              {
                members.state = {
                  type = providers.local.state_file;
                  inputs.name = "basic-state.json";
                };
                # fx_computed: the provider populates `id =
                # "computed-<value>"` at Plan time. Exercises the
                # full round-trip: user-supplied input → provider
                # process → computed output → downstream Nix.
                members.echo = {
                  type = providers.tfFixture.fx_computed;
                  state = members.state;
                  inputs.value = "hello";
                };
                # Persist the computed output so the check can find
                # it in the state file.
                members.witness = {
                  type = providers.local.memo;
                  state = members.state;
                  inputs.initialize_with = members.echo.outputs.id;
                };
              };

            # Sensitive round-trip. Extends the basic itest with a
            # scenario that exercises the sensitive-value machinery
            # end-to-end. The provider process writes the received
            # `secret` (already revealed by nixops4-resource's
            # strip on input) to `write_to`, and populates
            # `computed_secret` with a derived plain string. The
            # tfproto adapter wraps `computed_secret` as a marker
            # (based on the schema flag) before returning to
            # nixops4. Downstream Nix then sees a proper eval-time
            # marker.
            members.sensitiveDeployment =
              { members, ... }:
              let
                inherit (inputs.nixops4.lib.sensitive) mkSensitive isSensitive;
              in
              {
                members.state = {
                  type = providers.local.state_file;
                  inputs.name = "sensitive-state.json";
                };
                members.echo = {
                  type = providers.tfFixture.fx_sensitive;
                  state = members.state;
                  inputs.secret = mkSensitive { provenance = "test-fixture"; } "hunter2";
                  inputs.write_to = "sensitive-echo-observed.txt";
                };
                # Downstream reconstruction check: the memo
                # persists a corroborating string when
                # `echo.outputs.computed_secret` reads as a proper
                # sensitive marker downstream. A throw on the else
                # branch makes a regression surface at eval time
                # (visible failure) rather than silently persisting
                # a plain string.
                members.echoOutputAssertion = {
                  type = providers.local.memo;
                  state = members.state;
                  inputs.initialize_with =
                    if isSensitive members.echo.outputs.computed_secret then
                      "echo.outputs.computed_secret is a proper sensitive marker"
                    else
                      throw "REGRESSION: echo.outputs.computed_secret is not a sensitive marker";
                };
              };
          };
      }
    );
}
